# ==============================================================================
# Blockchain-Based Byzantine-Resilient FL for Smart Grid Theft Detection
# Environment Configuration Template
# ==============================================================================

# General Application Settings
PROJECT_NAME="Blockchain-Based Byzantine-Resilient Federated Learning for Smart Grid Energy Theft Detection"
ENVIRONMENT=development
LOG_LEVEL=INFO
RANDOM_SEED=42

# MongoDB Database Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=smart_grid_theft_fl

# Federated Learning Server
FL_SERVER_HOST=127.0.0.1
FL_SERVER_PORT=8080
FL_NUM_ROUNDS=10
FL_MIN_CLIENTS=5
FL_BATCH_SIZE=32
FL_LOCAL_EPOCHS=3
FL_LEARNING_RATE=0.001

# Blockchain & Smart Contract Configuration
# Options for BLOCKCHAIN_PROVIDER_TYPE: 'eth_tester' (in-memory EVM testbed) or 'http' (Ganache/Anvil/Geth)
BLOCKCHAIN_PROVIDER_TYPE=eth_tester
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_CHAIN_ID=1337
BLOCKCHAIN_ACCOUNT_ADDRESS=0x90F8bf6A479f320ead074411a4B0e7944Ea8c9C1
BLOCKCHAIN_PRIVATE_KEY=0x4f3edf983ac636a65a842ce7c78d9aa706d3b113bce9c46f30d7d21715b23b1d
REPUTATION_REGISTRY_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Backend FastAPI Service
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Frontend Vite Dashboard
VITE_API_BASE_URL=http://127.0.0.1:8000/api
VITE_WS_BASE_URL=ws://127.0.0.1:8000/ws

# Smart Meter & MDMS Simulators
MDMS_HOST=127.0.0.1
MDMS_PORT=8001
SIMULATOR_NUM_METERS=100
SIMULATOR_SAMPLING_FREQ_MINUTES=15
SIMULATOR_THEFT_RATIO=0.15
